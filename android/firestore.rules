rules_version = '2';
// TagVerify rules for the dealer app and the admin web panel.
// Schema and permission table: docs/DATA_MODEL.md
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function userPath() { return /databases/$(database)/documents/users/$(myEmail()); }
    function me() { return get(userPath()).data; }
    function isActive() { return signedIn() && exists(userPath()) && me().active == true; }
    function isAdmin() { return isActive() && me().role == 'admin'; }
    function isDealer() { return isActive() && me().role == 'dealer'; }
    function myCompany() { return me().companyId; }

    // Everyone may read their own profile (that's how login checks access).
    // Only admins manage users.
    match /users/{email} {
      allow read: if signedIn() && (email == myEmail() || isAdmin());
      allow write: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if isAdmin() || (isDealer() && companyId == myCompany());
      allow write: if isAdmin();
    }

    match /masters/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /counters/{docId} {
      allow read, write: if isAdmin();
    }

    match /qrBatches/{batchId} {
      allow read, write: if isAdmin();
    }

    // Dealers see their company's QR codes and may only flip an unused one to
    // certified (linking the certificate). Everything else is admin-only.
    match /qrCodes/{qrId} {
      // resource == null lets a dealer learn "not registered" vs "not your company".
      allow read: if isAdmin() || (isDealer() && (resource == null || resource.data.companyId == myCompany()));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isDealer()
        && resource.data.companyId == myCompany()
        && resource.data.status == 'unused'
        && request.resource.data.status == 'certified'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'certificateId'])
      );
    }

    // Public page behind every QR (no personal data): anyone can read.
    match /publicCertificates/{qrId} {
      allow read: if true;
      allow write: if isAdmin() || isDealer();
    }

    match /certificates/{certId} {
      allow read: if isAdmin() || (isDealer() && resource.data.companyId == myCompany());
      allow create: if isAdmin() || (
        isDealer()
        && request.resource.data.companyId == myCompany()
        && request.resource.data.dealerEmail == myEmail()
      );
      allow update, delete: if isAdmin();
    }
  }
}
