rules_version = '2';
// TagVerify MVP rules (dealer app). Admin edits happen in the Firebase console,
// which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function dealerPath() { return /databases/$(database)/documents/dealers/$(myEmail()); }
    function isDealer() {
      return signedIn() && exists(dealerPath()) && get(dealerPath()).data.active == true;
    }
    function myCompany() { return get(dealerPath()).data.companyId; }

    // A dealer can read only their own profile. Profiles are managed by admin.
    match /dealers/{email} {
      allow read: if signedIn() && email == myEmail();
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read: if isDealer() && companyId == myCompany();
      allow write: if false;
    }

    match /masters/{docId} {
      allow read: if isDealer();
      allow write: if false;
    }

    // QR codes: readable by dealers of the same company; a dealer may only
    // flip an unused QR of their company to certified.
    match /qrCodes/{qrId} {
      allow read: if isDealer() && resource.data.companyId == myCompany();
      allow update: if isDealer()
        && resource.data.companyId == myCompany()
        && resource.data.status == 'unused'
        && request.resource.data.status == 'certified'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'certificateId']);
    }

    // Certificates: dealers read their company's; create only as themselves.
    match /certificates/{certId} {
      allow read: if isDealer() && resource.data.companyId == myCompany();
      allow create: if isDealer()
        && request.resource.data.companyId == myCompany()
        && request.resource.data.dealerId == myEmail();
      allow update, delete: if false;
    }
  }
}
