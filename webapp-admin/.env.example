# Copy to .env.local and fill in from Firebase Console → Project settings → Your apps → TagVerify Admin (Web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tagverify-5f8b1.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tagverify-5f8b1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tagverify-5f8b1.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=203809165633
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base URL encoded into every QR code. Scanning a QR opens <base>/c/<qrId>.
NEXT_PUBLIC_PUBLIC_BASE_URL=https://tagverify-5f8b1.web.app
